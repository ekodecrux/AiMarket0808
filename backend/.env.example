MONGO_URL="mongodb://localhost:27017"
DB_NAME="ai_marketing_engine"
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# LLM (Emergent Universal Key or your own Groq key)
EMERGENT_LLM_KEY="your-emergent-llm-key"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# Auth
JWT_SECRET="generate-a-long-random-hex-string"
ADMIN_EMAIL="admin@marketing.ai"
ADMIN_PASSWORD="admin123"
ADMIN_PHONE="+10000000000"

# Credential vault (Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
CREDENTIALS_KEY="generate-a-fernet-key"

# Email (Gmail SMTP with App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
EMAIL_FROM="you@gmail.com"
EMAIL_FROM_NAME="AIMarketing"

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# Google Identity. Use a comma-separated allow-list of registered Web, Android, and iOS OAuth client IDs.
# This server validates ID-token signature, issuer, audience, expiry, and nonce. Do not place client secrets in the app.
GOOGLE_AUTH_CLIENT_IDS=""
# Web-only public client ID returned through /api/auth/providers for the browser sign-in control.
GOOGLE_AUTH_WEB_CLIENT_ID=""
